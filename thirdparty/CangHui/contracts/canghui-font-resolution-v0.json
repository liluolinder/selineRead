{
  "schema": "canghui.font-resolution.v0",
  "defaultFamily": "HarmonyOS Sans SC",
  "bundledAsset": "assets/fonts/HarmonyOS_Sans_SC.ttf",
  "license": "assets/fonts/HARMONYOS_SANS_LICENSE.txt",
  "sourceNotice": "assets/fonts/HARMONYOS_SANS_SOURCE.txt",
  "resolutionOrder": [
    "component-registered-family",
    "theme-family",
    "application-family",
    "bundled-harmonyos-sans",
    "platform-system-ui"
  ],
  "missingGlyphPolicy": "select the first face that covers every printable rune in the text run; otherwise render deterministically with the first usable face",
  "boldPolicy": "prefer an in-file Bold named instance, then a discoverable companion file, and otherwise synthesize bold on the selected base face",
  "runtimeOverride": "CANGHUI_HARMONYOS_SANS",
  "publicApi": [
    "Fonts.register",
    "Fonts.useApplicationFamily",
    "Fonts.registerBundledFallback",
    "Fonts.resolutionChain",
    "Theme.withFontFamily",
    "Renderer.fontResolution",
    "Renderer.fontResolutionForText"
  ]
}
