{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://celading.dev/canghui/component-package-v0.schema.json",
  "title": "CangHui Component Package v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "displayName",
    "version",
    "minimumCuiVersion",
    "platforms",
    "requiredCapabilities",
    "assets",
    "nativeArtifacts"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "minLength": 1 },
    "displayName": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "minimumCuiVersion": { "type": "string", "minLength": 1 },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["common", "desktop", "android", "harmonyos", "ios"]
      }
    },
    "requiredCapabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "assets": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "nativeArtifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["platform", "architecture", "path", "sha256", "license"],
        "properties": {
          "platform": { "enum": ["desktop", "android", "harmonyos", "ios"] },
          "architecture": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "license": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
