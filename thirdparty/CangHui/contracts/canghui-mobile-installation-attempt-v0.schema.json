{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://canghui.dev/contracts/canghui-mobile-installation-attempt-v0.schema.json",
  "title": "CangHui mobile installation attempt receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol", "platform", "packageKind", "sourceStage", "applicationId",
    "lifecycleEpoch", "surfaceGeneration", "state", "outcome", "outputName",
    "platformOwner", "targetDeviceClass", "installerTool", "installationPolicy",
    "installationReceiptId", "artifactDigest", "artifactSize", "limitations",
    "recorded", "installed", "installationProven", "launchProven",
    "renderingProven", "deviceProven"
  ],
  "properties": {
    "protocol": { "const": "canghui.mobile-installation-attempt.v0" },
    "platform": { "enum": ["ios", "android", "harmonyos"] },
    "packageKind": {
      "enum": [
        "ios-application-bundle",
        "android-application-package",
        "harmony-application-package"
      ]
    },
    "sourceStage": { "enum": ["contract-ready", "input-tree", "signed-package", "device-proven"] },
    "applicationId": { "type": "string", "minLength": 1 },
    "lifecycleEpoch": { "type": "integer", "minimum": 0 },
    "surfaceGeneration": { "type": "integer", "minimum": 0 },
    "state": { "enum": ["rejected", "recorded"] },
    "outcome": { "enum": ["failed", "installed"] },
    "outputName": { "type": "string", "pattern": "^[A-Za-z0-9:._-]+$", "maxLength": 255 },
    "platformOwner": { "type": "string", "pattern": "^[A-Za-z0-9:._-]+$", "maxLength": 128 },
    "targetDeviceClass": { "enum": ["physical-device", "simulator-or-emulator", "managed-device-pool"] },
    "installerTool": { "type": "string", "pattern": "^[A-Za-z0-9:._-]+$", "maxLength": 128 },
    "installationPolicy": { "type": "string", "pattern": "^[A-Za-z0-9:._-]+$", "maxLength": 128 },
    "installationReceiptId": { "type": "string", "pattern": "^[A-Za-z0-9:._-]+$", "maxLength": 128 },
    "artifactDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "artifactSize": { "type": "integer", "minimum": 1 },
    "limitations": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "recorded": { "type": "boolean" },
    "installed": { "type": "boolean" },
    "installationProven": { "type": "boolean" },
    "launchProven": { "const": false },
    "renderingProven": { "const": false },
    "deviceProven": { "const": false }
  },
  "allOf": [
    {
      "if": { "properties": { "platform": { "const": "ios" } } },
      "then": { "properties": { "packageKind": { "const": "ios-application-bundle" } } }
    },
    {
      "if": { "properties": { "platform": { "const": "android" } } },
      "then": { "properties": { "packageKind": { "const": "android-application-package" } } }
    },
    {
      "if": { "properties": { "platform": { "const": "harmonyos" } } },
      "then": { "properties": { "packageKind": { "const": "harmony-application-package" } } }
    },
    {
      "if": { "properties": { "state": { "const": "recorded" } } },
      "then": {
        "properties": {
          "sourceStage": { "const": "signed-package" },
          "recorded": { "const": true }
        }
      },
      "else": {
        "properties": {
          "recorded": { "const": false },
          "installed": { "const": false },
          "installationProven": { "const": false }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": { "const": "recorded" },
          "outcome": { "const": "installed" }
        },
        "required": ["state", "outcome"]
      },
      "then": {
        "properties": {
          "installed": { "const": true },
          "installationProven": { "const": true }
        }
      },
      "else": {
        "properties": {
          "installed": { "const": false },
          "installationProven": { "const": false }
        }
      }
    }
  ]
}
