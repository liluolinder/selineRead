{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://canghui.dev/contracts/canghui-mobile-host-replay-v0.schema.json",
  "title": "CangHui mobile host semantic replay",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "receipt", "installable", "deviceProven", "callbacks"],
  "properties": {
    "protocol": { "const": "canghui.mobile-host-replay.v0" },
    "receipt": { "$ref": "canghui-mobile-host-package-v0.schema.json" },
    "installable": { "type": "boolean" },
    "deviceProven": { "type": "boolean" },
    "callbacks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["actionId", "lifecycleEpoch", "surfaceGeneration", "accepted", "decision"],
        "properties": {
          "actionId": { "type": "string", "minLength": 1 },
          "lifecycleEpoch": { "type": "integer", "minimum": 0 },
          "surfaceGeneration": { "type": "integer", "minimum": 0 },
          "accepted": { "type": "boolean" },
          "decision": {
            "enum": ["current", "stale-lifecycle", "stale-surface", "stale-lifecycle-and-surface"]
          }
        }
      }
    }
  }
}
