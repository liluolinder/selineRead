{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://canghui.dev/contracts/canghui-symbol-v0.schema.json",
  "title": "CangHui Symbol CLI protocols",
  "oneOf": [
    { "$ref": "#/$defs/catalogReport" },
    { "$ref": "#/$defs/generationReceipt" }
  ],
  "$defs": {
    "symbolToken": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "symbolEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "aliases", "variants", "directional", "sourcePath"],
      "properties": {
        "name": { "$ref": "#/$defs/symbolToken" },
        "aliases": {
          "type": "array",
          "items": { "$ref": "#/$defs/symbolToken" },
          "uniqueItems": true
        },
        "variants": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["outlined", "filled", "rounded", "sharp"] },
          "uniqueItems": true
        },
        "directional": { "type": "boolean" },
        "sourcePath": { "type": "string", "minLength": 1 }
      }
    },
    "providerCatalog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "repository", "revision", "version", "license", "symbols"],
      "properties": {
        "id": { "$ref": "#/$defs/symbolToken" },
        "repository": { "type": "string", "format": "uri" },
        "revision": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "license": { "type": "string", "minLength": 1 },
        "symbols": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/symbolEntry" }
        }
      }
    },
    "catalogReport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "providers"],
      "properties": {
        "schema": { "const": "canghui.symbol.catalog.v0" },
        "providers": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/providerCatalog" }
        }
      }
    },
    "generatedSymbol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "name", "export"],
      "properties": {
        "provider": { "$ref": "#/$defs/symbolToken" },
        "name": { "$ref": "#/$defs/symbolToken" },
        "export": { "type": "string", "pattern": "^[a-z_][a-z0-9_]*$" }
      }
    },
    "generationReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "output", "package", "symbols"],
      "properties": {
        "schema": { "const": "canghui.symbol.generation.v0" },
        "output": { "type": "string", "minLength": 1 },
        "package": { "type": "string", "pattern": "^[a-z_][a-z0-9_]*$" },
        "symbols": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/generatedSymbol" }
        }
      }
    }
  }
}
